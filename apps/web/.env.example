# Anthropic API Key
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# YouTube Data API v3 Key
# Get yours at: https://console.cloud.google.com/
# Enable the YouTube Data API v3 in your project
YOUTUBE_API_KEY=AIza...

# Supadata API Key (Optional)
# Required for cloud deployments (Vercel, etc.)
# Leave unset for local development - uses youtube-transcript-plus instead
# Get yours at: https://supadata.ai/
SUPADATA_API_KEY=

# Neon API key and project id, used by `pnpm db:sync-from-prod` to reset the dev branch from production
NEON_API_KEY=
NEON_PROJECT_ID=

# Owner's WorkOS user ids (they differ per environment). After a sync from production,
# rows owned by the production id are moved to the local id so they show up locally.
# DEV_OWNER_PROD_USER_ID=user_01KF7XZX6PZ0W4E1ZTYXFQ96RW
# DEV_OWNER_LOCAL_USER_ID=user_01KF7N1S7XBZ7J5VB7WKPZYDXE
